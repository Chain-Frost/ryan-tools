{
  // Select the user's normal Python 3.14 installation. This repository does not
  // expect users to create or activate a virtual environment.
  "python.defaultInterpreterPath": "",
  "python.terminal.activateEnvironment": false,
  "python.analysis.indexing": true,
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "path": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
    },
    "OSGeo4W Cmd": {
      "path": "C:\\Windows\\System32\\cmd.exe",
      "args": [
        "/K",
        "C:\\OSGeo4W\\OSGeo4W.bat"
      ]
    }
  },
  "python-envs.defaultEnvManager": "ms-python.python:system",
  "python.analysis.exclude": [
    "excel-resources/**",
    "**/node_modules",
    "**/__pycache__",
    "**/.*",
    "examples/**",
    "build/**",
    "dist/**",
    "docs/**",
    "qgis-resources/**",
    "pytest-cache-files-*/**",
    "ryan_functions.egg-info/**",
    "tests/test_data/**",
    "unsorted/**",
    ".git/**"
  ],
  "files.watcherExclude": {
    "**/build/**": true,
    "**/dist/**": true,
    "**/excel-resources/**": true,
    "**/qgis-resources/**": true,
    "**/tests/test_data/**": true,
    "**/unsorted/**": true,
    "**/pytest-cache-files-*/**": true,
    "**/ryan_functions.egg-info/**": true,
    "**/__pycache__/**": true
  }
}