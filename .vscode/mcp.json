{
  "servers": {
    "ryan-tools": {
      "command": "python",
      "args": [
        "-m",
        "ryan_library.mcp.server"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONUTF8": "1",
        "RYAN_TOOLS_REPOSITORY_ROOT": "${workspaceFolder}",
        "RYAN_MCP_PROFILE": "create"
      }
    }
  }
}
