{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "python:install-requirements",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "if ($env:RYAN_TOOLS_PYTHON) { & $env:RYAN_TOOLS_PYTHON -m pip install -r '${workspaceFolder}\\requirements.txt' } else { py -3.14 -m pip install -r '${workspaceFolder}\\requirements.txt' }"
      ],
      "problemMatcher": []
    },
    {
      "label": "python:stdin",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "$snippet = if ($env:RYAN_TOOLS_SNIPPET) { $env:RYAN_TOOLS_SNIPPET } else { '${workspaceFolder}\\repo-scripts\\run_snippet.py' }; if ($env:RYAN_TOOLS_PYTHON) { Get-Content -Raw - | & $env:RYAN_TOOLS_PYTHON $snippet } else { Get-Content -Raw - | py -3.14 $snippet }"
      ],
      "problemMatcher": []
    },
    {
      "label": "qgis:python-current-file",
      "type": "shell",
      "command": "C:\\OSGeo4W\\bin\\python-qgis.bat",
      "args": [
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "qgis:python-repl",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/K",
        "C:\\OSGeo4W\\bin\\python-qgis.bat"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "qgis:open-qgis",
      "type": "shell",
      "command": "C:\\OSGeo4W\\bin\\qgis.bat",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
