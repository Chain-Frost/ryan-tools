! EVENTS_01.tef
! Event File for <<PROJECT_NAME>>

! Rainfall method/source events used by the TCF loss and BC Database block.
Define Event ==  Nested
    BC Event Source == ~ROC~ | 1.0
End Define

Define Event == EnsembleILCL
    BC BC Event Source == ~CC~ | Near-term_SSP3-7.0 ! tpv-ignore
End Define

Define Event ==  PMF
    BC Event Source == ~ROC~ | 1.0
End Define

Define Event ==  PMP
    BC Event Source == ~PMP~ | PMP
End Define

Define Event == ILCL 
