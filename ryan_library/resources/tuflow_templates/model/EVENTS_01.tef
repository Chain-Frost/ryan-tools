! EVENTS_01.tef
! Event File for <<PROJECT_NAME>>

Define Event ==  Nested
    BC Event Source == ~ROC~ | 1.0
End Define

Define Event == EnsembleILCL
    BC Event Source == ~EnsembleILCL~ | EnsembleILCL
End Define

! Climate selection is independent of rainfall method. Review against the BC database.
Define Event == CCNear
    BC Event Source == ~CC~ | Near-term_SSP3-7.0 ! tpv-ignore
End Define

Define Event ==  PMF
    BC Event Source == ~ROC~ | 1.0
End Define

Define Event ==  PMP
    BC Event Source == ~PMP~ | PMP
End Define

Define Event == ILCL 
