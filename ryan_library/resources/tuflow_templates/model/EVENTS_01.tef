! EVENTS_01.tef
! Event File for <<PROJECT_NAME>>

! Rainfall method/source events used by the TCF loss and BC Database block.
Define Event ==  Nested
    BC Event Source == ~ROC~ | 1.0
End Define

Define Event == EnsembleILCL
    BC Event Source == ~EnsembleILCL~ | EnsembleILCL
End Define

! Climate selection is independent of rainfall method. Review against the BC database.
Define Event == CCNear
    BC Event Source == ~CC~ | Near-term_SSP3-7.0 ! tpv-ignore
End Define

Define Event ==  PMF
    BC Event Source == ~ROC~ | 1.0
End Define

Define Event ==  PMP
    BC Event Source == ~PMP~ | PMP
End Define

Define Event == ILCL 
    BC Event Source == ~ROC~ | 1.0
End Define

Define Event == NestedILCL 
    BC Event Source == ~ROC~ | 1.0
End Define

Define Event == NestedNL
    BC Event Source == ~ROC~ | 1.0
End Define

Define Event == Model
    BC Event Source == ~StormDuration~ | Model
End Define

Define Event == Dummy
    BC Event Source == ~TP~ | Dummy
End Define

! AEP events. Add any aliases required by the selected BC databases.
Define Event == 01.0p
