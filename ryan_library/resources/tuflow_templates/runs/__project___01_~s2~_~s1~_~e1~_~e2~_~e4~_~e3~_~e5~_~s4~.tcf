! <<PROJECT_NAME>>
! Date: <<DATE>>
! File assumed to be in TUFLOW/runs

! Scenario         s1      Baseline scenarios - DEV or EXG generally
! Extent           s2      Model extent
! GridSize         s4      Base grid size
! AEP              e1      Boundary-condition AEP
! StormDuration    e2      Storm duration
! TP               e3      Temporal pattern
! Method           e4      Method/source, such as PMP, Nested, or EnsembleILCL
! Climate Change   e5      Independent climate-change selection, such as CCNear

!**** Control Files ****
	Set Variable Version ==		01
	Set Variable OutputBase ==	..
	Set Variable OutputRoot ==	results\<<Version>>\<<~s4~>>_<<~e4~>>\<<~s2~>>_<<~s1~>>\<<~e1~>>\<<~e5~>>
	Log Folder ==				<<OutputBase>>\<<OutputRoot>>\Log
	Output Folder ==			<<OutputBase>>\<<OutputRoot>>
	Write Check Files == 		<<OutputBase>>\<<OutputRoot>>\check\
	Set Variable OutInterval ==	60 ! seconds

	Geometry Control File ==	..\model\GEOM_01.tgc
	BC Control File ==			..\model\BOUND_01.tbc
	BC Event File ==			..\model\EVENTS_01.tef
	! ESTRY Control File ==		..\model\ECF_001.ecf

	Read Materials File ==		..\model\Materials_01.csv
	Read Soils File ==			..\model\Soil_01.tsoilf ! Soil 99 has no losses
	Read File ==				..\runs\model_cell_sizes_01.trd ! Cell sizes

	Start Time ==				0
	Read File ==				..\runs\run_times_01.trd ! End times
	Timestep ==						1
	Time Series Output Interval ==	<<OutInterval>>

	! Project-specific rainfall database paths and loss values: edit before running.
	If Event == PMP
		BC Database ==				..\bc_dbase\bc_dbase_PMP_01.csv
		Set Variable InitialLoss ==	0
		Set Variable ContLoss ==	0
	Else If Event == NestedILCL | NestedNL ! Nested
		BC Database ==				..\bc_dbase\bc_dbase_nested_01.csv
		Set Variable InitialLoss ==	0
		Set Variable ContLoss ==	0
	Else If Event == EnsembleILCL
		! Check preburst handling in the rainfall inputs to avoid applying it twice or missing it.
		Read File ==				..\model\soils_losses_01.trd
		BC Database ==				..\bc_dbase\ARR19\bc_dbase_CC.csv
	Else
		Pause == No rainfall input selected
	End If

	Set Variable IL_MAT ==	0
	Set Variable CL_MAT ==	0

	GPKG Projection ==			..\model\gis\<<PROJECTION_NAME>>.gpkg
	TIF Projection ==			..\model\gis\<<PROJECTION_NAME>>.tif

!*** PO Lines ***
	! Read GIS PO ==	..\model\gis\2d_po_<<PROJECT_NAME>>_01_L.gpkg
	! Read GIS PO ==	..\model\gis\2d_po_<<PROJECT_NAME>>_01_P.gpkg

!**** Output ****
	Map Output Format ==			TIF HRTIF
	TIF Map Output Data Types == 	d h v dt !Nu Nc Nd !ZAEM1 !Z0 ZAEM1
	HRTIF Map Output Data Types == 	d h
	TIF Start Map Output ==			0
	TIF Map Output Interval ==		0
	HRTIF Start Map Output ==		0
	HRTIF Map Output Interval ==	0
	Map Output Interval ==			0 ! maximum-only maps; time series still use OutInterval
	Store Maximums and Minimums == ON MAXIMUMS ONLY

	Write Check Files INCLUDE ==	dem_Z

!**** Solver & Miscellaneous ****
	Solution Scheme ==				HPC
	Hardware ==						GPU
	SGS ==							ON
	SGS Max Sample Frequency ==		11
	Cell Wet/Dry Depth ==			0.0002
	Screen/Log Display Interval ==	200
	Check Inside Grid ==			WARNING
	GIS Projection Check ==			ERROR
	! Optional COG grid writing: enable both commands after checking the application environment.
	! Use GDAL ==					ON
	! Grid Format ==				COG
	Grid Format ==					TIF
	GIS Format ==					GPKG
	XF Files Include in Filename ==	<<~s1~>>_<<~s2~>>
