"""Minimal local type surface for pyshp's read-only DBF and test fixture APIs.

pyshp ships no type stubs. Keep this narrow and extend only with tested
interfaces; it does not imply pyshp supports GIS feature typing generally.
"""

from collections.abc import Iterator, Sequence
from typing import Any, Self

NULL: int
POINT: int
POLYLINE: int
POLYLINEZ: int
POLYLINEM: int

class ShapefileException(Exception): ...

class Reader:
    shapeType: int
    fields: list[tuple[str, str, int, int]]

    def __init__(self, *args: object, **kwargs: object) -> None: ...
    def iterRecords(self) -> Iterator[Sequence[object]]: ...
    def iterShapes(self) -> Iterator[object]: ...
    def iterShapeRecords(self) -> Iterator[object]: ...
    def close(self) -> None: ...
    def __getattr__(self, name: str) -> Any: ...

class Writer:
    def __init__(self, *args: object, **kwargs: object) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, exc_type: object, exc_value: object, traceback: object) -> None: ...
    def field(self, fieldName: str, fieldType: str = "C", size: int = 50, decimal: int = 0) -> None: ...
    def null(self) -> None: ...
    def record(self, *recordList: object, **recordDict: object) -> None: ...
    def close(self) -> None: ...
    def __getattr__(self, name: str) -> Any: ...
