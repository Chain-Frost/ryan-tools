class CRS:
    @classmethod
    def from_epsg(cls, code: int) -> CRS: ...
    @classmethod
    def from_wkt(cls, wkt: str) -> CRS: ...
    @classmethod
    def from_string(cls, value: str) -> CRS: ...
    @property
    def is_projected(self) -> bool: ...
    @property
    def linear_units_factor(self) -> tuple[str, float]: ...
    def to_wkt(self) -> str: ...
    def to_epsg(self) -> int | None: ...
